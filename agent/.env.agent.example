# ==============================================================================
# VAULT SHIELD - ALPHA AGENT RUNTIME ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env.agent and populate with actual credentials.
# NEVER commit .env.agent or any private keys to version control.
# ==============================================================================

# Target NEAR Network & Endpoints
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_FALLBACK_RPC_URL=https://test.rpc.fastnear.com

# Target Vault Shield Contract
VAULT_CONTRACT_ID=contract.vault-parent.testnet

# Authorized Agent Identity
AGENT_ACCOUNT_ID=agent-a.vault-parent.testnet

# Expected Restricted Function-Call Public Key
AGENT_EXPECTED_PUBLIC_KEY=ed25519:2H8EupC9ApTAPYPMu3a5DWxDdcX6X3wX22tcqsocV9Kq

# Agent Restricted Private Key (ed25519:...)
# Injected via OS environment variable, secret manager, or local .env.agent
# MUST correspond to the restricted Function-Call Access Key, NOT FullAccess.
AGENT_PRIVATE_KEY=ed25519:your_restricted_private_key_here

# Local Ledger & Concurrency Lock
AGENT_LEDGER_PATH=./data/ledger.json
AGENT_LOCKFILE_PATH=./.agent.lock

# Phase 1 Strict Boundary: Blocks live broadcasts unless explicitly bypassed with testing flags
AGENT_PHASE1_STRICT_BOUNDARY=true

