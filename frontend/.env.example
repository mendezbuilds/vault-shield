# NEAR AI AGENT VAULT — Environment Configuration Template
# Public NEAR Testnet parameters for Vault Shield deployment

# Target Contract Account on NEAR Public Testnet
VITE_NEAR_CONTRACT_ID=contract.vault-parent.testnet

# Public NEAR Testnet RPC Endpoint (Primary upstream)
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org

# Fallback FastNEAR RPC Endpoint
VITE_NEAR_FALLBACK_RPC_URL=https://test.rpc.fastnear.com

# NEAR Testnet Network ID
VITE_NEAR_NETWORK_ID=testnet
